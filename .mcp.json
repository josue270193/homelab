{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "firefox": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mozilla/firefox-devtools-mcp@0.10.7",
        "--connect-existing",
        "--marionette-port",
        "2828",
        "--viewport",
        "1280x720"
      ],
      "env": {}
    }
  }
}
