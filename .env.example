# Copy to .env and fill in real values. Never commit .env.
# cp .env.example .env

# General
TZ=America/Argentina/Buenos_Aires
# Base domain for public subdomains (e.g. whoami.${DOMAIN}). Use "localhost" for local dev.
DOMAIN=localhost

# Cloudflare Tunnel (E2) – token from the Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=

# Postgres (E4) – internal network only, never published
# Required, no default: generate one (see README). Only applied when the volume is first created.
POSTGRES_DB=homelab
POSTGRES_USER=homelab
POSTGRES_PASSWORD=

# Postgres backups (E4) – optional, defaults shown
# BACKUP_TIME=03:00
# BACKUP_KEEP_DAYS=7
# BACKUP_DIR=./backups/postgres

# Dockge (E3) – absolute path to this repo's services/ folder (mounted at the same path inside Dockge)
STACKS_DIR=/absolute/path/to/homelab/services

# Tailscale (E4) – private DB access. Auth key from Tailscale admin > Settings > Keys
# (one-off, not ephemeral, pre-approved). Only used on first login; state persists in data/tailscale.
TS_AUTHKEY=
# Optional, e.g. --advertise-tags=tag:homelab (tagged devices don't expire; needs a tag in your ACL)
# TS_EXTRA_ARGS=

# API image (E5)
# API_TAG=latest                 # or sha-<short sha> to pin the build CI published to GHCR
# Production only (CachyOS PC): ignore compose.override.yaml so the API is pulled, never built
# COMPOSE_FILE=compose.yaml
