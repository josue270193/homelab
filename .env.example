# Copy to .env and fill in real values. Never commit .env.
# cp .env.example .env

# General
TZ=America/Argentina/Buenos_Aires
# Base domain for PUBLIC routers (entrypoint `public`, e.g. whoami.${DOMAIN}); local routers use *.localhost.
DOMAIN=josuedev.dpdns.org
# Host port for Traefik on 127.0.0.1 (default 80). Set e.g. 8880 if another local stack uses :80.
# TRAEFIK_HTTP_PORT=80

# Cloudflare Tunnel (E2) – locally-managed, no token here: credentials live in
# data/cloudflared/<tunnel-id>.json and routes in cloudflared/config.yml (see docs/tunnel.md)

# Postgres (E4) – internal network only, never published
# Required, no default: generate one (see README). Only applied when the volume is first created.
POSTGRES_DB=homelab
POSTGRES_USER=homelab
POSTGRES_PASSWORD=

# Postgres backups (E4) – optional, defaults shown
# BACKUP_TIME=03:00
# BACKUP_KEEP_DAYS=7
# BACKUP_DIR=./backups/postgres

# Dockge (E3) – absolute path to this repo's services/ folder (mounted at the same path inside Dockge)
STACKS_DIR=/absolute/path/to/homelab/services

# Forgejo (E10, #119): password for its own role/DB on the shared Postgres (created automatically).
FORGEJO_DB_PASSWORD=
# Tailscale name of this machine's `tailscale` service, used in SSH clone URLs.
# FORGEJO_SSH_DOMAIN=homelab-db.<tailnet>.ts.net
# Forgejo Actions runner (#121): from `POST /repos/<owner>/<repo>/actions/runners` (docs/forgejo.md).
# The token is a secret; regenerate it by deleting the runner and registering a new one.
FORGEJO_RUNNER_UUID=
FORGEJO_RUNNER_TOKEN=

# Files: OpenCloud + Euro-Office (E10, #125) – tailnet only, see docs/files.md
# Password of the built-in `admin` user. Only applied on the very first start (empty data dir).
OPENCLOUD_ADMIN_PASSWORD=
# Where files live on the host. Create it first, owned by uid 1000: sudo install -d -o 1000 -g 1000 <dir>
OPENCLOUD_DATA_DIR=/srv/homelab/files
# OPENCLOUD_LANGUAGE=en
# Shared secret of the Euro-Office document server: openssl rand -hex 32
EURO_OFFICE_JWT_SECRET=
# Cloudflare API token for Traefik's Let's Encrypt DNS-01 (certs for files./office.<domain>).
# Dashboard > My Profile > API Tokens > Create > "Edit zone DNS", zone = your DOMAIN only. Secret.
CF_DNS_API_TOKEN=

# Tailscale (E4) – private DB access. Auth key from Tailscale admin > Settings > Keys
# (one-off, not ephemeral, pre-approved). Only used on first login; state persists in data/tailscale.
TS_AUTHKEY=
# Optional, e.g. --advertise-tags=tag:homelab (tagged devices don't expire; needs a tag in your ACL)
# TS_EXTRA_ARGS=

# API image (E5)
# API_TAG=latest                 # or sha-<short sha> to pin the build CI published to Forgejo (#121)
# PORTFOLIO_TAG=latest           # same, for git.<domain>/josue/homelab-portfolio
# Portfolio contact form -> Telegram (#76). A DEDICATED bot (from @BotFather), not Uptime Kuma's.
# The form only turns on with CONTACT_ENABLED=true AND all four keys below set.
# Token is secret (looks like 123456789:AA...). Chat id = your numeric user id, e.g. from
# @userinfobot; press Start in the new bot once first. Comments go on their own line: Docker would
# read an inline "# ..." as part of the value.
# CONTACT_ENABLED=false
# CONTACT_TELEGRAM_BOT_TOKEN=
# CONTACT_TELEGRAM_CHAT_ID=
# Cloudflare Turnstile widget for the form (#77): dashboard -> Turnstile -> Add widget, hostname =
# your DOMAIN. The site key is public (sent to the browser); the secret key is not.
# CONTACT_TURNSTILE_SITE_KEY=
# CONTACT_TURNSTILE_SECRET_KEY=
# Production only (CachyOS PC): ignore compose.override.yaml so the API and portfolio are pulled, never built
# COMPOSE_FILE=compose.yaml
